{"openapi":"3.1.0","info":{"title":"Tic Tac Toe API","description":"Backend API for managing a digital Tic Tac Toe game.","version":"1.0.0"},"paths":{"/":{"get":{"tags":["Game"],"summary":"Health Check","description":"Health Check endpoint.\n\nReturns:\n    JSON message indicating health.","operationId":"health_check__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/game/start":{"post":{"tags":["Game"],"summary":"Start a new game","description":"Resets the board and starts a new Tic Tac Toe game.","operationId":"start_new_game_game_start_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GameStatus"}}}}}}},"/game/board":{"get":{"tags":["Game"],"summary":"Get board status","description":"Retrieves the current board state, active player, and outcome (if any).","operationId":"get_board_game_board_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GameStatus"}}}}}}},"/game/move":{"post":{"tags":["Game"],"summary":"Make a move","description":"Submit a move for the current player. Returns board state and status update.","operationId":"make_move_game_move_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Move"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GameStatus"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/game/restart":{"post":{"tags":["Game"],"summary":"Restart current game","description":"Restart the current game (clears the board, X goes first).","operationId":"restart_game_game_restart_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/